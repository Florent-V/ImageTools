# Inside the web container; TLS and HSTS are handled by the Caddy in front
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	handle /auth/* {
		reverse_proxy api:8000
	}

	handle /api/* {
		request_body {
			max_size 210MB
		}
		# flush_interval -1: stream uploads/downloads, don't buffer 200 MB in Caddy
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} {path}/index.html /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# 'unsafe-inline' scripts: the Nuxt bootstrap config is inline. img/media blob: and
		# data: are needed for the previews. default-src still blocks any external resource.
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'"
	}
}
