# ── Dev stack (make up / make dev / make down / make logs) ──────────────
BACKEND_PORT=8010
FRONTEND_PORT=3000

# ── prod-home stack (make up-home): single Caddy entrypoint ─────────────
HOME_PORT=8080

# ── prod-remote stack (make up-remote): no bundled Caddy, raw ports ─────
REMOTE_BACKEND_PORT=8011
REMOTE_FRONTEND_PORT=3010

# ── Backend (all profiles) ───────────────────────────────────────────────
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000
