# ── Dev stack (make dev): http://localhost:FRONTEND_PORT ───────────────
FRONTEND_PORT=3001

# ── Production (make prod-up / prod-deploy): behind the global Caddy ────
REMOTE_FRONTEND_PORT=3010

# ── Backend (all profiles) ───────────────────────────────────────────────
MAX_UPLOAD_MB=50

# ── Authentication ───────────────────────────────────────────────────────
# The backend is the OAuth client (BFF): everything else (endpoints, signing
# keys) is read from <OAUTH_ISSUER>/.well-known/oauth-authorization-server.
# Exact issuer of the OAuth server, as it publishes it (trailing slash included).
OAUTH_ISSUER=http://localhost:8080
# Application declared on the OAuth server: client ID and secret it generated,
# redirect URI {PUBLIC_ORIGIN}/auth/callback,
# back-channel logout URI {PUBLIC_ORIGIN}/auth/backchannel-logout.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Public origin of this app, no trailing slash (https:// in production)
PUBLIC_ORIGIN=http://localhost:3001
# prod (default) or dev. dev allows http and COOKIE_SECURE=false; the dev
# override of docker-compose sets both, leave them unset here.
# APP_ENV=prod
